# --- GOOGLE CALENDAR CONFIGURATIONS ---
# The path to your Google Service Account credential file (placed in this directory)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Your target Google Calendar ID (e.g. your email or a specific shared calendar ID)
# Default is 'primary', which points to the primary calendar of the authenticated account
GOOGLE_CALENDAR_ID=primary

# --- GMAIL CLIENT CONFIGURATIONS (SMTP Email Confirmation) ---
# Your Gmail account email address
GMAIL_USER=your-email@gmail.com

# Your Gmail App Password (NOT your normal account password, but a 16-character SMTP pass generated via Google Account Security)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
